+++ b/src/web_font.rs
@@ -0,0 +1,144 @@
+// Copyright 2026 the 3JSN Authors
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+
+//! Per-registration CSS matching and coverage, separate from immutable font bytes.
+
+use crate::{Attributes, FontStyle, FontWeight, FontWidth};
+use alloc::{sync::Arc, vec::Vec};
+
+/// The style descriptor of a web font. Oblique bounds are inclusive CSS degrees.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum WebFontStyle {
+    Normal,
+    Italic,
+    Oblique { min: f32, max: f32 },
+}
+
+/// Invalid input to [`WebFontFace::new`].
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum WebFontError {
+    UnicodeRange,
+    WeightRange,
+    WidthRange,
+    ObliqueRange,
+}
+
+impl core::fmt::Display for WebFontError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        write!(f, "invalid web-font {:?}", self)
+    }
+}
+impl core::error::Error for WebFontError {}
+
+/// Validated descriptors for one CSS face registration.
+///
+/// Callers supply CSS defaults, rather than inferring omitted descriptors from
+/// font metadata. `source_order` is stylesheet order, never request completion
+/// order. Distinct rules in one family must have distinct source orders.
+#[derive(Clone, Debug)]
+pub struct WebFontFace {
+    source_order: u64,
+    unicode_ranges: Arc<[(u32, u32)]>,
+    weight: (f32, f32),
+    width: (f32, f32),
+    style: WebFontStyle,
+}
+
+impl WebFontFace {
+    /// Creates a face with inclusive Unicode, weight, width and style ranges.
+    /// Width is a CSS percentage (normal is 100). An empty Unicode list permits
+    /// no characters; an omitted CSS descriptor is represented by 0..=0x10FFFF.
+    pub fn new(
+        source_order: u64,
+        unicode_ranges: &[(u32, u32)],
+        weight_range: (f32, f32),
+        width_range: (f32, f32),
+        style: WebFontStyle,
+    ) -> Result<Self, WebFontError> {
+        fn ordered((min, max): (f32, f32)) -> bool {
+            min.is_finite() && max.is_finite() && min <= max
+        }
+        if !ordered(weight_range) || weight_range.0 < 1.0 || weight_range.1 > 1000.0 {
+            return Err(WebFontError::WeightRange);
+        }
+        if !ordered(width_range) || width_range.0 <= 0.0 {
+            return Err(WebFontError::WidthRange);
+        }
+        if let WebFontStyle::Oblique { min, max } = style {
+            if !ordered((min, max)) || min < -90.0 || max > 90.0 {
+                return Err(WebFontError::ObliqueRange);
+            }
+        }
+        let mut ranges = unicode_ranges.to_vec();
+        if ranges.iter().any(|&(min, max)| min > max || max > 0x10FFFF) {
+            return Err(WebFontError::UnicodeRange);
+        }
+        ranges.sort_unstable();
+        let mut merged: Vec<(u32, u32)> = Vec::with_capacity(ranges.len());
+        for (min, max) in ranges {
+            if let Some(last) = merged.last_mut().filter(|last| min <= last.1 + 1) {
+                last.1 = last.1.max(max);
+            } else {
+                merged.push((min, max));
+            }
+        }
+        Ok(Self {
+            source_order,
+            unicode_ranges: merged.into(),
+            weight: weight_range,
+            width: width_range,
+            style,
+        })
+    }
+
+    pub fn source_order(&self) -> u64 {
+        self.source_order
+    }
+    pub fn unicode_ranges(&self) -> &[(u32, u32)] {
+        &self.unicode_ranges
+    }
+    pub fn weight_range(&self) -> (f32, f32) {
+        self.weight
+    }
+    pub fn width_range(&self) -> (f32, f32) {
+        self.width
+    }
+    pub fn style(&self) -> WebFontStyle {
+        self.style
+    }
+
+    /// Tests the original Unicode scalar, before symbol or legacy cmap remapping.
+    pub fn contains(&self, codepoint: u32) -> bool {
+        contains(&self.unicode_ranges, codepoint)
+    }
+
+    pub(crate) fn attributes(
+        &self,
+        width: FontWidth,
+        style: FontStyle,
+        weight: FontWeight,
+    ) -> Attributes {
+        let style = match self.style {
+            WebFontStyle::Normal => FontStyle::Normal,
+            WebFontStyle::Italic => FontStyle::Italic,
+            WebFontStyle::Oblique { min, max } => {
+                let target = match style {
+                    FontStyle::Normal => 0.0,
+                    FontStyle::Italic => 14.0,
+                    FontStyle::Oblique(angle) => angle.unwrap_or(14.0),
+                };
+                FontStyle::Oblique(Some(target.clamp(min, max)))
+            }
+        };
+        Attributes::new(
+            FontWidth::from_percentage(width.percentage().clamp(self.width.0, self.width.1)),
+            style,
+            FontWeight::new(weight.value().clamp(self.weight.0, self.weight.1)),
+        )
+    }
+}
+
+pub(crate) fn contains(ranges: &[(u32, u32)], codepoint: u32) -> bool {
+    let index = ranges.partition_point(|&(_, max)| max < codepoint);
+    ranges.get(index).is_some_and(|&(min, _)| min <= codepoint)
+}
