+            let mut dom = doc.mutate();
+            let parent = dom.create_element(qual_name!("section", html), vec![]);
+            dom.append_children(root, &[parent]);
+            dom.append_children(parent, &[owner]);
+            parent
+        };
+        doc.load_web_fonts().unwrap();
+        doc.handle_messages();
+        doc.check_web_fonts().unwrap();
+        doc.mutate().remove_node(parent);
+        assert_eq!(
+            doc.check_web_fonts(),
+            Err(WebFontLoadError::DynamicMutation)
+        );
+    }
+    #[test]
+    fn queued_decoded_bytes_are_bounded_before_document_registration() {
+        let budget = AtomicUsize::new(MAX_DECODED_DOCUMENT_BYTES - 1);
+        assert!(account_decoded_font(&budget, 1).is_ok());
+        assert!(account_decoded_font(&budget, 1).is_err());
+        assert_eq!(budget.load(Ordering::Relaxed), MAX_DECODED_DOCUMENT_BYTES);
+    }
+
+    #[test]
+    fn format_hints_must_match_actual_font_bytes() {
+        assert!(decode_font(Format::Woff2, Bytes::from_static(crate::BULLET_FONT)).is_err());
+        assert!(decode_font(Format::None, Bytes::from_static(crate::BULLET_FONT)).is_ok());
+        assert!(decode_font(Format::Truetype, Bytes::from_static(b"OTTO")).is_ok());
+        assert!(decode_font(Format::Opentype, Bytes::from_static(b"\0\x01\0\0")).is_ok());
+        assert!(decode_font(Format::None, Bytes::from_static(b"ttcf")).is_err());
+        assert!(decode_font(Format::None, Bytes::from_static(b"wOF2garbage")).is_err());
+    }
+
+    #[cfg(feature = "woff")]
+    #[test]
+    fn woff_directory_bound_does_not_trust_total_sfnt_size() {
+        let mut bytes = vec![0; 64];
+        bytes[12..14].copy_from_slice(&1u16.to_be_bytes());
+        bytes[16..20].copy_from_slice(&32u32.to_be_bytes());
+        bytes[56..60].copy_from_slice(&4u32.to_be_bytes());
+        assert!(validate_woff1_size(&bytes).is_ok());
+        bytes[56..60].copy_from_slice(&(MAX_DECODED_FACE_BYTES as u32).to_be_bytes());
+        assert!(validate_woff1_size(&bytes).is_err());
+        bytes[56..60].copy_from_slice(&u32::MAX.to_be_bytes());
+        assert!(validate_woff1_size(&bytes).is_err());
+    }
+}
