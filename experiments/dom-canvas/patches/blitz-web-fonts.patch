new file mode 100644
--- /dev/null
+++ b/packages/blitz-dom/src/web_fonts.rs
@@ -0,0 +1,917 @@
+//! Checked initial CSS font loading. The opt-in snapshot preserves CSS order,
+//! descriptors and decode failures; changing the face set later is unsupported.
+
+use std::{
+    collections::HashSet,
+    error::Error,
+    fmt,
+    sync::{
+        Arc,
+        atomic::{AtomicUsize, Ordering},
+    },
+};
+
+use blitz_traits::net::Bytes;
+use parley::fontique::{WebFontFace, WebFontStyle};
+use style::{
+    font_face::{
+        Descriptors, FontFaceSourceFormat, FontFaceSourceFormatKeyword as Format, FontStyleRange,
+        Source,
+    },
+    shared_lock::SharedRwLockReadGuard,
+    stylesheets::{
+        CssRule, StylesheetInDocument,
+        import_rule::{ImportLayer, ImportSheet},
+    },
+};
+use url::Url;
+
+use crate::{
+    BaseDocument, NodeId,
+    net::{FontFaceHandler, FontFaceOverrides, ResourceHandler, stamped_request},
+};
+
+const MAX_FACES: usize = 1024;
+const MAX_DECODED_FACE_BYTES: usize = 128 * 1024 * 1024;
+const MAX_DECODED_DOCUMENT_BYTES: usize = 256 * 1024 * 1024;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum WebFontLoadError {
+    NotDeferred,
+    NotStarted,
+    Pending,
+    Unsupported(&'static str),
+    InvalidDescriptor(&'static str),
+    DynamicMutation,
+    Limit(&'static str),
+    Load {
+        url: Option<String>,
+        message: String,
+    },
+}
+impl fmt::Display for WebFontLoadError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::NotDeferred => f.write_str("checked web fonts require defer_font_loads"),
+            Self::NotStarted => f.write_str("checked web font loading has not started"),
+            Self::Pending => f.write_str("stylesheet or font loading is still pending"),
+            Self::Unsupported(what) => write!(f, "unsupported checked web font behavior: {what}"),
+            Self::InvalidDescriptor(what) => write!(f, "invalid web font descriptor: {what}"),
+            Self::DynamicMutation => {
+                f.write_str("dynamic font-rule set/order mutation is unsupported")
+            }
+            Self::Limit(what) => write!(f, "web font limit exceeded: {what}"),
+            Self::Load { url, message } => write!(
+                f,
+                "web font load failed at {}: {message}",
+                url.as_deref().unwrap_or("unknown URL")
+            ),
+        }
+    }
+}
+impl Error for WebFontLoadError {}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct WebFontLoadStatus {
+    pub requested: usize,
+    pub registered: usize,
+    pub pending: usize,
+    pub decoded_bytes: usize,
+}
+
+#[derive(Default)]
+pub(crate) struct WebFontState {
+    pub(crate) enabled: bool,
+    pub(crate) dirty: bool,
+    pub(crate) pending: HashSet<usize>,
+    pub(crate) registered: usize,
+    decoded_bytes: usize,
+    signature: Option<Vec<String>>,
+    decoded_budget: Arc<AtomicUsize>,
+    generation: u64,
+    error: Option<WebFontLoadError>,
+    #[cfg(test)]
+    owner_checks: AtomicUsize,
+}
+impl WebFontState {
+    pub(crate) fn new(enabled: bool) -> Self {
+        Self {
+            enabled,
+            ..Self::default()
+        }
+    }
+    pub(crate) fn fail(&mut self, error: WebFontLoadError) {
+        if self.error.is_none() {
+            self.error = Some(error);
+        }
+    }
+    pub(crate) fn accept_decoded_bytes(&mut self, bytes: usize) -> Result<(), WebFontLoadError> {
+        if bytes > MAX_DECODED_FACE_BYTES {
+            return Err(WebFontLoadError::Limit("decoded face bytes"));
+        }
+        self.decoded_bytes = self
+            .decoded_bytes
+            .checked_add(bytes)
+            .filter(|total| *total <= MAX_DECODED_DOCUMENT_BYTES)
+            .ok_or(WebFontLoadError::Limit("decoded document bytes"))?;
+        Ok(())
+    }
+}
+
+#[derive(Debug)]
+struct FaceRequest {
+    url: Url,
+    format: Format,
+    overrides: FontFaceOverrides,
+}
+
+impl BaseDocument {
+    /// Call after all initial stylesheets/imports have arrived, then drain
+    /// responses and call `check_web_fonts` before application layout/painting.
+    /// No source fallback or asynchronous font-display timing is implemented.
+    pub fn load_web_fonts(&mut self) -> Result<(), WebFontLoadError> {
+        if !self.web_fonts.enabled {
+            return Err(WebFontLoadError::NotDeferred);
+        }
+        if self.web_fonts.signature.is_some() {
+            return self.check_web_fonts().map(|_| ());
+        }
+        if let Some(error) = &self.web_fonts.error {
+            return Err(error.clone());
+        }
+        let owners = self.font_stylesheet_owners();
+        let requests = match self.collect_web_fonts(&owners) {
+            Ok(requests) => requests,
+            Err(error) => {
+                self.web_fonts.fail(error.clone());
+                return Err(error);
+            }
+        };
+        self.web_fonts.signature = Some(requests.iter().map(|r| format!("{r:?}")).collect());
+        self.web_fonts.generation = self.stylesheet_generation;
+        self.web_fonts.dirty = false;
+        for request in requests {
+            let handler = ResourceHandler::new(
+                self.tx.clone(),
+                self.id(),
+                None,
+                self.shell_provider.clone(),
+                FontFaceHandler {
+                    format: request.format,
+                    overrides: request.overrides,
+                    decoded_budget: Some(self.web_fonts.decoded_budget.clone()),
+                },
+            );
+            self.web_fonts.pending.insert(handler.request_id());
+            self.net_provider.fetch(
+                self.id(),
+                stamped_request(request.url, self.abort_signal.as_ref()),
+                Box::new(handler),
+            );
+        }
+        Ok(())
+    }
+
+    /// Recheck after DOM/CSS callbacks and before layout. Ordinary text/style
+    /// changes are allowed; face removal, replacement or reordering is sticky.
+    /// Direct mutation through public interior cells bypasses this API contract.
+    pub fn check_web_fonts(&mut self) -> Result<WebFontLoadStatus, WebFontLoadError> {
+        if !self.web_fonts.enabled {
+            return Err(WebFontLoadError::NotDeferred);
+        }
+        if let Some(error) = &self.web_fonts.error {
+            return Err(error.clone());
+        }
+        let Some(original) = &self.web_fonts.signature else {
+            return Err(WebFontLoadError::NotStarted);
+        };
+        if self.web_fonts.dirty || self.web_fonts.generation != self.stylesheet_generation {
+            let owners = self.font_stylesheet_owners();
+            let check = self.collect_web_fonts(&owners).map(|requests| {
+                requests
+                    .iter()
+                    .map(|r| format!("{r:?}"))
+                    .collect::<Vec<_>>()
+            });
+            match check {
+                Ok(signature) if signature == *original => {}
+                Ok(_) => {
+                    self.web_fonts.fail(WebFontLoadError::DynamicMutation);
+                    return Err(WebFontLoadError::DynamicMutation);
+                }
+                Err(error) => {
+                    self.web_fonts.fail(error.clone());
+                    return Err(error);
+                }
+            }
+            self.web_fonts.generation = self.stylesheet_generation;
+            self.web_fonts.dirty = false;
+        }
+        if self.has_pending_critical_resources() || !self.web_fonts.pending.is_empty() {
+            return Err(WebFontLoadError::Pending);
+        }
+        Ok(WebFontLoadStatus {
+            requested: self.web_fonts.signature.as_ref().unwrap().len(),
+            registered: self.web_fonts.registered,
+            pending: self.web_fonts.pending.len(),
+            decoded_bytes: self.web_fonts.decoded_bytes,
+        })
+    }
+
+    fn font_stylesheet_owners(&self) -> Vec<(NodeId, bool)> {
+        #[cfg(test)]
+        self.web_fonts.owner_checks.fetch_add(1, Ordering::Relaxed);
+        let mut owners = Vec::new();
+        for &id in self.nodes_to_stylesheet.keys() {
+            let mut current = id;
+            let mut path = Vec::new();
+            while current != self.root_node_id {
+                let Some(parent) = self.nodes[current].parent else {
+                    break;
+                };
+                path.push(
+                    self.nodes[parent]
+                        .index_of_child(current)
+                        .expect("font owner must belong to its parent"),
+                );
+                current = parent;
+            }
+            if current != self.root_node_id {
+                continue;
+            }
+            path.reverse();
+            let restricted = self.nodes[id].element_data().is_some_and(|el| {
+                el.attr(crate::local_name!("media"))
+                    .is_some_and(|value| !value.is_empty())
+                    || el.attr(crate::local_name!("rel")).is_some_and(|value| {
+                        value
+                            .split_ascii_whitespace()
+                            .any(|part| part.eq_ignore_ascii_case("alternate"))
+                    })
+                    || el.attr(crate::local_name!("disabled")).is_some()
+                    || el.attr(crate::local_name!("type")).is_some_and(|value| {
+                        !value.is_empty() && !value.eq_ignore_ascii_case("text/css")
+                    })
+            });
+            owners.push((path, id, restricted));
+        }
+        owners.sort_unstable_by(|a, b| a.0.cmp(&b.0));
+        owners
+            .into_iter()
+            .map(|(_, id, restricted)| (id, restricted))
+            .collect()
+    }
+
+    fn collect_web_fonts(
+        &self,
+        owners: &[(NodeId, bool)],
+    ) -> Result<Vec<FaceRequest>, WebFontLoadError> {
+        if self.has_pending_critical_resources() {
+            return Err(WebFontLoadError::Pending);
+        }
+        let guard = self.guard.read();
+        let mut faces = Vec::new();
+        for (id, restricted) in owners {
+            let sheet = &self.nodes_to_stylesheet[id].0;
+            let conditional =
+                *restricted || sheet.media(&guard).is_some_and(|media| !media.is_empty());
+            collect_rules(
+                sheet.contents(&guard).rules(&guard),
+                &guard,
+                conditional,
+                &mut faces,
+                0,
+            )?;
+        }
+        Ok(faces)
+    }
+}
+
+fn collect_rules(
+    rules: &[CssRule],
+    guard: &SharedRwLockReadGuard,
+    conditional: bool,
+    faces: &mut Vec<FaceRequest>,
+    depth: usize,
+) -> Result<(), WebFontLoadError> {
+    if depth > 64 {
+        return Err(WebFontLoadError::Limit("font rule nesting"));
+    }
+    for rule in rules {
+        if let CssRule::FontFace(face) = rule {
+            if conditional {
+                return Err(WebFontLoadError::Unsupported(
+                    "conditional, nested or layered font faces",
+                ));
+            }
+            if faces.len() == MAX_FACES {
+                return Err(WebFontLoadError::Limit("font faces"));
+            }
+            faces.push(face_request(
+                &face.read_with(guard).descriptors,
+                faces.len() as u64,
+            )?);
+        } else if let CssRule::Import(import) = rule {
+            let import = import.read_with(guard);
+            if matches!(import.stylesheet, ImportSheet::Pending) {
+                return Err(WebFontLoadError::Pending);
+            }
+            // Refused imports cannot be inspected, so reject their conditions
+            // instead of accepting a hidden face set that can later activate.
+            if matches!(import.stylesheet, ImportSheet::Refused) {
+                return Err(WebFontLoadError::Unsupported("refused stylesheet import"));
+            }
+            let condition = conditional
+                || import.supports.is_some()
+                || !matches!(import.layer, ImportLayer::None)
+                || import
+                    .stylesheet
+                    .media(guard)
+                    .is_some_and(|media| !media.is_empty());
+            collect_rules(
+                import.stylesheet.rules(guard),
+                guard,
+                condition,
+                faces,
+                depth + 1,
+            )?;
+        } else {
+            collect_rules(rule.children(guard), guard, true, faces, depth + 1)?;
+        }
+    }
+    Ok(())
+}
+
+fn face_request(d: &Descriptors, source_order: u64) -> Result<FaceRequest, WebFontLoadError> {
+    let invalid = WebFontLoadError::InvalidDescriptor;
+    if d.font_feature_settings.is_some()
+        || d.font_variation_settings.is_some()
+        || d.font_language_override.is_some()
+        || d.ascent_override.is_some()
+        || d.descent_override.is_some()
+        || d.line_gap_override.is_some()
+        || d.size_adjust.is_some()
+    {
+        return Err(WebFontLoadError::Unsupported(
+            "font metrics, feature, variation or language overrides",
+        ));
+    }
+    let family = d
+        .font_family
+        .as_ref()
+        .ok_or(invalid("font-family"))?
+        .name
+        .to_string();
+    let sources = &d.src.as_ref().ok_or(invalid("src"))?.0;
+    if sources.len() != 1 {
+        return Err(WebFontLoadError::Unsupported("font source-list fallback"));
+    }
+    let Source::Url(source) = &sources[0] else {
+        return Err(WebFontLoadError::Unsupported("local() font sources"));
+    };
+    if !source.tech_flags.is_empty() {
+        return Err(WebFontLoadError::Unsupported("font source tech()"));
+    }
+    let format = match &source.format_hint {
+        None => Format::None,
+        Some(FontFaceSourceFormat::Keyword(format)) => *format,
+        Some(FontFaceSourceFormat::String(value)) => match value.as_str() {
+            "woff" => Format::Woff,
+            "woff2" => Format::Woff2,
+            "truetype" | "ttf" => Format::Truetype,
+            "opentype" | "otf" => Format::Opentype,
+            _ => return Err(WebFontLoadError::Unsupported("font format")),
+        },
+    };
+    if !matches!(
+        format,
+        Format::None | Format::Woff | Format::Woff2 | Format::Truetype | Format::Opentype
+    ) {
+        return Err(WebFontLoadError::Unsupported("font format"));
+    }
+    let url = source
+        .url
+        .url()
+        .ok_or(invalid("font URL"))?
+        .as_ref()
+        .clone();
+    let weight = if let Some(range) = &d.font_weight {
+        let range = range.compute().ok_or(invalid("font-weight"))?;
+        (range.0.value(), range.1.value())
+    } else {
+        (400.0, 400.0)
+    };
+    let width = if let Some(range) = &d.font_stretch {
+        let range = range.compute().ok_or(invalid("font-stretch"))?;
+        (
+            range.0.to_percentage().0 * 100.0,
+            range.1.to_percentage().0 * 100.0,
+        )
+    } else {
+        (100.0, 100.0)
+    };
+    let font_style = match &d.font_style {
+        None => WebFontStyle::Normal,
+        Some(FontStyleRange::Italic) => WebFontStyle::Italic,
+        Some(FontStyleRange::Oblique(first, last)) => {
+            let first = first.degrees().ok_or(invalid("font-style"))?;
+            let last = last.degrees().ok_or(invalid("font-style"))?;
+            if first == 0.0 && last == 0.0 {
+                WebFontStyle::Normal
+            } else {
+                WebFontStyle::Oblique {
+                    min: first.min(last),
+                    max: first.max(last),
+                }
+            }
+        }
+    };
+    let ranges = d
+        .unicode_range
+        .as_ref()
+        .map(|ranges| ranges.iter().map(|r| (r.start, r.end)).collect::<Vec<_>>())
+        .unwrap_or_else(|| vec![(0, 0x10ffff)]);
+    let face = WebFontFace::new(source_order, &ranges, weight, width, font_style)
+        .map_err(|_| invalid("face ranges"))?;
+    Ok(FaceRequest {
+        url,
+        format,
+        overrides: FontFaceOverrides {
+            family_name: Some(family),
+            web_font: Some(face),
+            ..Default::default()
+        },
+    })
+}
+
+pub(crate) fn decode_font(format: Format, bytes: Bytes) -> Result<Bytes, String> {
+    let sniffed = match bytes.get(..4) {
+        Some(b"wOFF") => Format::Woff,
+        Some(b"wOF2") => Format::Woff2,
+        Some(b"OTTO") => Format::Opentype,
+        Some(b"\0\x01\0\0" | b"true") => Format::Truetype,
+        _ => return Err("unsupported or invalid font signature".into()),
+    };
+    // CSS Fonts 4 makes these two sfnt hints synonymous, regardless of outline type.
+    let sfnt_hint = matches!(format, Format::Truetype | Format::Opentype)
+        && matches!(sniffed, Format::Truetype | Format::Opentype);
+    if format != Format::None && format != sniffed && !sfnt_hint {
+        return Err("font format hint does not match bytes".into());
+    }
+    let decoded = match sniffed {
+        #[cfg(feature = "woff")]
+        Format::Woff => {
+            validate_woff1_size(&bytes)?;
+            wuff::decompress_woff1(&bytes)
+                .map(Bytes::from)
+                .map_err(|error| format!("WOFF decode: {error:?}"))?
+        }
+        #[cfg(feature = "woff")]
+        Format::Woff2 => {
+            // wuff 0.2.9 bounds its directory-derived stream and reconstructed
+            // output to 128 MiB. Header totalSfntSize alone is not a safe bound.
+            wuff::decompress_woff2(&bytes)
+                .map(Bytes::from)
+                .map_err(|error| format!("WOFF2 decode: {error:?}"))?
+        }
+        Format::Truetype | Format::Opentype => bytes,
+        _ => return Err("WOFF support was not compiled".into()),
+    };
+    if !matches!(decoded.get(..4), Some(b"OTTO" | b"\0\x01\0\0" | b"true")) {
+        return Err(
+            "decoded font must be a single OpenType/TrueType face; collections are unsupported"
+                .into(),
+        );
+    }
+    if decoded.len() > MAX_DECODED_FACE_BYTES {
+        return Err("decoded font exceeds 128 MiB".into());
+    }
+    Ok(decoded)
+}
+
+#[cfg(feature = "woff")]
+fn validate_woff1_size(bytes: &[u8]) -> Result<(), String> {
+    let read32 = |offset| {
+        bytes
+            .get(offset..offset + 4)
+            .and_then(|b| b.try_into().ok())
+            .map(u32::from_be_bytes)
+            .map(|n| n as usize)
+    };
+    let fail = || "invalid or excessive WOFF table directory".to_string();
+    if bytes.len() < 44 {
+        return Err(fail());
+    }
+    let count = u16::from_be_bytes([bytes[12], bytes[13]]) as usize;
+    if count == 0 || count > 4095 || 44 + count * 20 > bytes.len() {
+        return Err(fail());
+    }
+    let mut decoded = 12 + count * 16;
+    for i in 0..count {
+        let offset = 44 + i * 20;
+        let compressed = read32(offset + 8).ok_or_else(fail)?;
+        let original = read32(offset + 12).ok_or_else(fail)?;
+        if compressed > original {
+            return Err(fail());
+        }
+        decoded = decoded
+            .checked_add(original.checked_add(3).ok_or_else(fail)? & !3)
+            .ok_or_else(fail)?;
+        if decoded > MAX_DECODED_FACE_BYTES {
+            return Err(fail());
+        }
+    }
+    if read32(16) != Some(decoded) {
+        return Err(fail());
+    }
+    Ok(())
+}
+
+/// Bound retained decoded messages before the document drains them. With the
+/// synchronous package provider, one additional face can be decoding at a time.
+pub(crate) fn account_decoded_font(budget: &AtomicUsize, bytes: usize) -> Result<(), String> {
+    budget
+        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |total| {
+            total
+                .checked_add(bytes)
+                .filter(|value| *value <= MAX_DECODED_DOCUMENT_BYTES)
+        })
+        .map(|_| ())
+        .map_err(|_| "decoded font responses exceed 256 MiB".into())
+}
