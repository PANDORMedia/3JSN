+struct WebFontFuncs<'a>(&'a fontique::WebFontFace);
+
+impl harfrust::font::FontFuncs for WebFontFuncs<'_> {
+    fn nominal_glyph(
+        &mut self,
+        builtin: &harfrust::font::BuiltinFontFuncs<'_>,
+        codepoint: u32,
+    ) -> Option<harfrust::GlyphId> {
+        self.0
+            .contains(codepoint)
+            .then(|| builtin.nominal_glyph(codepoint))
+            .flatten()
+    }
+
+    fn variant_glyph(
+        &mut self,
+        builtin: &harfrust::font::BuiltinFontFuncs<'_>,
+        codepoint: u32,
+        selector: u32,
+    ) -> Option<harfrust::GlyphId> {
+        self.0
+            .contains(codepoint)
+            .then(|| builtin.variant_glyph(codepoint, selector))
+            .flatten()
+    }
+}
