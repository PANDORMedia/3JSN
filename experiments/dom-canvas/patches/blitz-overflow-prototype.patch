+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum UnsupportedHoistedClip {
+    MissingNode(NodeId),
+    MissingStyle(NodeId),
+    DisconnectedLayoutPath,
+    AbsoluteContainingBlockEscape(NodeId),
+    FixedContainingBlock(NodeId),
+    StickyPosition(NodeId),
+    Containment(NodeId),
+    UnexpectedStackingAncestor(NodeId),
+    OverflowAxes(NodeId),
+    TransformedScrolling,
+}
+
+pub(crate) struct HoistedClipPlan {
+    parent_transform: Affine,
+    cull_rect: Rect,
+    clips: Vec<(Affine, kurbo::BezPath)>,
+}
+
+/// Generated box ancestors skipped by painting, ordered outermost first.
+pub(crate) fn hoisted_layout_path(
+    dom: &BaseDocument,
+    root: NodeId,
+    child: NodeId,
+) -> Result<Vec<NodeId>, UnsupportedHoistedClip> {
+    let mut path = Vec::new();
+    let mut next = dom
+        .get_node(child)
+        .ok_or(UnsupportedHoistedClip::MissingNode(child))?
+        .layout_parent
+        .get();
+    while let Some(id) = next {
+        if id == root {
+            path.reverse();
+            return Ok(path);
+        }
+        let node = dom
+            .get_node(id)
+            .ok_or(UnsupportedHoistedClip::MissingNode(id))?;
+        path.push(id);
+        next = node.layout_parent.get();
+    }
+    Err(UnsupportedHoistedClip::DisconnectedLayoutPath)
+}
+
+/// Validate ownership below the outermost restored clip. That clip owner's own
+/// placement is outside this test: the repair consumes its existing layout.
+pub(crate) fn validate_hoisted_clip_ownership(
+    dom: &BaseDocument,
+    child: NodeId,
+    outermost_clip: Option<NodeId>,
+) -> Result<(), UnsupportedHoistedClip> {
+    use style::computed_values::position::T as Position;
+    let mut next = Some(child);
+    while let Some(id) = next {
+        if Some(id) == outermost_clip {
+            return Ok(());
+        }
+        let node = dom
+            .get_node(id)
+            .ok_or(UnsupportedHoistedClip::MissingNode(id))?;
+        let styles = node
+            .primary_styles()
+            .ok_or(UnsupportedHoistedClip::MissingStyle(id))?;
+        if styles
+            .get_box()
+            .clone_contain()
+            .intersects(Contain::LAYOUT | Contain::PAINT)
+        {
+            return Err(UnsupportedHoistedClip::Containment(id));
+        }
+        match styles.clone_position() {
+            Position::Fixed => return Err(UnsupportedHoistedClip::FixedContainingBlock(id)),
+            Position::Sticky => return Err(UnsupportedHoistedClip::StickyPosition(id)),
+            Position::Absolute => {
+                let parent = node.layout_parent.get().and_then(|id| dom.get_node(id));
+                let local_owner = parent.is_some_and(|parent| {
+                    node.parent == Some(parent.id)
+                        && parent.primary_styles().is_some_and(|style| {
+                            style.clone_position() != Position::Static
+                                || parent.transform().is_some()
+                        })
+                });
+                if !local_owner {
+                    return Err(UnsupportedHoistedClip::AbsoluteContainingBlockEscape(id));
+                }
+            }
+            Position::Static | Position::Relative => {}
+        }
+        if outermost_clip.is_none() {
+            return Ok(());
+        }
+        next = node.layout_parent.get();
+    }
+    Err(UnsupportedHoistedClip::DisconnectedLayoutPath)
+}
 
