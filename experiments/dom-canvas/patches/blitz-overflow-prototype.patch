+    fn render_hoisted_child(
+        &self,
+        scene: &mut impl PaintScene,
+        node_id: NodeId,
+        legacy_position: taffy::Point<f32>,
+        parent_style_transform: Affine,
+        clip_rect: Rect,
+    ) {
+        let plan = self.context.hoisted_clip_plan(
+            self.node.id,
+            node_id,
+            parent_style_transform,
+            clip_rect,
+        );
+        let Ok(plan) = plan else {
+            // Preserve legacy painting outside this research prototype's scope.
+            // This fallback is not observable through the public paint API.
+            let pos =
+                Vec2::new(f64::from(legacy_position.x), f64::from(legacy_position.y)) * self.scale;
+            self.render_node(
+                scene,
+                node_id,
+                parent_style_transform.pre_translate(pos),
+                clip_rect,
+            );
+            return;
+        };
+        if plan.cull_rect.width() <= 0.0 || plan.cull_rect.height() <= 0.0 {
+            return;
+        }
+        let mut pushed = 0;
+        for (transform, path) in &plan.clips {
+            if !self
+                .layer_manager
+                .maybe_push_layer(scene, true, 1.0, *transform, path, None, None)
+            {
+                // Exhausting the layer budget must not turn a required clip off.
+                for _ in 0..pushed {
+                    self.layer_manager.maybe_pop_layer(scene, true);
+                }
+                return;
+            }
+            pushed += 1;
+        }
+        self.render_node(scene, node_id, plan.parent_transform, plan.cull_rect);
+        for _ in 0..pushed {
+            self.layer_manager.maybe_pop_layer(scene, true);
+        }
+    }
