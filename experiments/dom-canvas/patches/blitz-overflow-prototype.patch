+    pub(crate) fn hoisted_clip_plan(
+        &self,
+        root: NodeId,
+        child: NodeId,
+        root_contents: Affine,
+        clip_rect: Rect,
+    ) -> Result<HoistedClipPlan, UnsupportedHoistedClip> {
+        let dom = self.dom.as_ref();
+        let path = hoisted_layout_path(dom, root, child)?;
+        let root_node = dom
+            .get_node(root)
+            .ok_or(UnsupportedHoistedClip::MissingNode(root))?;
+        let [a, b, c, d, _, _] = root_contents.as_coeffs();
+        if [a, b, c, d] != [1.0, 0.0, 0.0, 1.0]
+            && (root_node.scroll_offset().x != 0.0 || root_node.scroll_offset().y != 0.0)
+        {
+            return Err(UnsupportedHoistedClip::TransformedScrolling);
+        }
+        let mut parent_transform = root_contents;
+        let mut cull_rect = clip_rect;
+        let mut clips = Vec::new();
+        let mut outermost_clip = None;
+        for id in path {
+            let node = dom
+                .get_node(id)
+                .ok_or(UnsupportedHoistedClip::MissingNode(id))?;
+            let styles = node
+                .primary_styles()
+                .ok_or(UnsupportedHoistedClip::MissingStyle(id))?;
+            if node.stacking_context.is_some()
+                || node.transform().is_some()
+                || styles.clone_opacity() != 1.0
+            {
+                return Err(UnsupportedHoistedClip::UnexpectedStackingAncestor(id));
+            }
+            let layout = node.final_layout();
+            let border_transform = parent_transform
+                * Affine::translate((
+                    f64::from(layout.location.x) * self.scale,
+                    f64::from(layout.location.y) * self.scale,
+                ))
+                * node.transform().as_deref().copied().unwrap_or_default();
+            let overflow = styles.get_box();
+            let clips_both_axes = match (overflow.overflow_x, overflow.overflow_y) {
+                (Overflow::Visible, Overflow::Visible) => false,
+                (
+                    Overflow::Hidden | Overflow::Auto | Overflow::Scroll,
+                    Overflow::Hidden | Overflow::Auto | Overflow::Scroll,
+                ) => true,
+                _ => return Err(UnsupportedHoistedClip::OverflowAxes(id)),
+            };
+            if clips_both_axes && self.root_element_id != Some(id) {
+                outermost_clip.get_or_insert(id);
+                let path = create_css_rect(&styles, layout, self.scale).padding_box_path();
+                let screen_transform =
+                    Affine::translate((-self.initial_x, -self.initial_y)) * border_transform;
+                cull_rect =
+                    cull_rect.intersect(screen_transform.transform_rect_bbox(path.bounding_box()));
+                clips.push((border_transform, path));
+            }
+            parent_transform = border_transform
+                * Affine::translate((
+                    -node.scroll_offset().x * self.scale,
+                    -node.scroll_offset().y * self.scale,
+                ));
+        }
+        validate_hoisted_clip_ownership(dom, child, outermost_clip)?;
+        Ok(HoistedClipPlan {
+            parent_transform,
+            cull_rect,
+            clips,
+        })
+    }
