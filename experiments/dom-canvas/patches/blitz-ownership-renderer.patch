+            OwnClips {
+                overflow: Some(shape(2.0)),
+                ..own()
+            },
+        )
+        .unwrap();
+        let (carrier, _) = route_box(
+            middle,
+            id(3),
+            Position::Absolute,
+            id(1),
+            ContainingBlockClaims {
+                absolute: true,
+                fixed: false,
+            },
+            own(),
+        )
+        .unwrap();
+        let (_, relative) = route_box(
+            carrier,
+            id(4),
+            Position::Relative,
+            id(3),
+            ContainingBlockClaims {
+                absolute: true,
+                fixed: false,
+            },
+            own(),
+        )
+        .unwrap();
+        assert_eq!(markers(&relative.decoration), [1.0]);
+    }
+
+    #[test]
+    fn an_empty_clip_is_not_absent_and_can_be_escaped_only_by_the_correct_route() {
+        let empty = resolved(id(1), BezPath::new(), Affine::IDENTITY).unwrap();
+        let (ancestor, contribution) = route_box(
+            initial(),
+            id(1),
+            Position::Absolute,
+            id(0),
+            ContainingBlockClaims {
+                absolute: true,
+                fixed: false,
+            },
+            OwnClips {
+                overflow: Some(empty),
+                ..own()
+            },
+        )
+        .unwrap();
+        assert!(!contribution.decoration.is_empty());
+        assert!(contribution.content.is_empty());
+        let (_, fixed) = route_box(
+            ancestor.clone(),
+            id(3),
+            Position::Fixed,
+            id(0),
+            ContainingBlockClaims::NONE,
+            own(),
+        )
+        .unwrap();
+        assert!(!fixed.decoration.is_empty());
+        let (middle, _) = route_box(
+            ancestor,
+            id(2),
+            Position::Static,
+            id(1),
+            ContainingBlockClaims::NONE,
+            OwnClips {
+                path: Some(shape(2.0)),
+                ..own()
+            },
+        )
+        .unwrap();
+        let (_, captured) = route_box(
+            middle,
+            id(3),
+            Position::Fixed,
+            id(0),
+            ContainingBlockClaims::NONE,
+            own(),
+        )
+        .unwrap();
+        assert!(captured.decoration.is_empty());
+    }
+
+    #[test]
+    fn a_resolved_owner_disagreement_is_an_error() {
+        let result = route_box(
+            ancestor(),
+            id(2),
+            Position::Fixed,
+            id(1),
+            ContainingBlockClaims::NONE,
+            own(),
+        );
+        assert!(
+            matches!(result, Err(ClipRouteError { node, issue: ClipRouteIssue::GeometryOwnerMismatch }) if node == id(2))
+        );
+    }
+
+    #[test]
+    fn device_space_shapes_keep_the_supplied_transform_without_double_scaling() {
+        let transform = Affine::translate((32.0, 24.0)) * Affine::rotate(0.25);
+        let path = Rect::new(16.0, 8.0, 96.0, 72.0).into_path(0.1);
+        let (clip, empty) = resolved(id(1), path.clone(), transform).unwrap();
+        assert!(!empty);
+        assert_eq!(clip.shape, path);
+        assert_eq!(clip.transform, transform);
+        assert!(
+            resolved(
+                id(1),
+                Rect::new(0.0, 0.0, f64::NAN, 1.0).into_path(0.1),
+                Affine::IDENTITY
+            )
+            .is_err()
+        );
+    }
+}
