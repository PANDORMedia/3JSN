+
+    fn own() -> OwnClips {
+        OwnClips {
+            path: None,
+            css_rect: None,
+            overflow: None,
+        }
+    }
+
+    fn markers(route: &ClipRoute) -> Vec<f64> {
+        route
+            .clips()
+            .map(|clip| clip.shape.bounding_box().x0)
