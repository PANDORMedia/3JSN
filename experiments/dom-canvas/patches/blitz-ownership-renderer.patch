--- /dev/null
+++ b/packages/blitz-paint/src/render/ownership_clips.rs
@@ -0,0 +1,753 @@
+//! Contribution clips for the experimental ownership renderer. Overflow follows
+//! resolved containing blocks; CSS rect is reparented for escaping descendants.
+//! Clip-path captures the incoming chain, matching the recorded Chrome controls.
+
+use std::collections::{HashMap, HashSet};
+use std::fmt;
+use std::sync::Arc;
+
+use blitz_dom::geometry::CssBox;
+use blitz_dom::paint_ownership::PaintOwnershipPlan;
+use blitz_dom::{BaseDocument, NodeId};
+use kurbo::{Affine, BezPath, Shape};
+use style::Zero;
+use style::computed_values::position::T as Position;
+use style::dom::TElement;
+use style::properties::ComputedValues;
+use style::values::computed::Overflow;
+use style::values::computed::basic_shape::ClipPath;
+use style::values::generics::basic_shape::{
+    FillRule, GenericBasicShape, ShapeBox, ShapeGeometryBox,
+};
+use taffy::ContainingBlockClaims;
+
+use super::clip_path::ClipPathGeometry;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ClipRouteIssue {
+    InvalidDocument,
+    InvalidFormattingTree,
+    UnpreparedFormattingParent,
+    MissingStyle,
+    MissingTransform,
+    GeometryOwnerMismatch,
+    InvalidScale,
+    NonFiniteGeometry,
+    UnsupportedClipPathUrl,
+    UnsupportedClipPathShape,
+    UnsupportedClipPathBox,
+    UnsupportedInsetRadius,
+    UnsupportedEvenOdd,
+    UnsupportedOverflowAxes,
+    UnsupportedOverflowClip,
+    UnsupportedViewportOverflow,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ClipRouteError {
+    pub node: NodeId,
+    pub issue: ClipRouteIssue,
+}
+
+impl fmt::Display for ClipRouteError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(formatter, "paint clip {:?} at {:?}", self.issue, self.node)
+    }
+}
+
+impl std::error::Error for ClipRouteError {}
+
+type Result<T> = std::result::Result<T, ClipRouteError>;
+type PreparedClip = (Arc<ResolvedClip>, bool);
+
+#[derive(Debug)]
+pub(super) struct ResolvedClip {
+    /// Local device-pixel shape; this affine does not apply the DPR again.
+    pub shape: BezPath,
+    pub transform: Affine,
+}
+
+#[derive(Clone, Debug, Default)]
+pub(super) struct ClipRoute {
+    clips: Vec<Arc<ResolvedClip>>,
+    empty: bool,
+}
+
+impl ClipRoute {
+    pub(super) fn is_empty(&self) -> bool {
+        self.empty
+    }
+
+    pub(super) fn clips(&self) -> impl Iterator<Item = &ResolvedClip> {
+        self.clips.iter().map(Arc::as_ref)
+    }
+
+    fn append(&self, shape: &Arc<ResolvedClip>, empty: bool) -> Self {
+        let mut route = self.clone();
+        route.clips.push(Arc::clone(shape));
+        route.empty |= empty;
+        route
+    }
+}
+
+#[derive(Clone)]
+struct PositionedContext {
+    owner: NodeId,
+    route: ClipRoute,
+}
+
+#[derive(Clone)]
+struct Context {
+    normal: ClipRoute,
+    absolute: PositionedContext,
+    fixed: PositionedContext,
+}
+
+struct Contributions {
+    decoration: ClipRoute,
+    content: ClipRoute,
+}
+
+pub(super) struct ClipRoutes {
+    nodes: HashMap<NodeId, Contributions>,
+}
+
+impl ClipRoutes {
+    pub(super) fn build(
+        document: &BaseDocument,
+        plan: &PaintOwnershipPlan<'_>,
+        transforms: &HashMap<NodeId, Affine>,
+        scale: f64,
+    ) -> Result<Self> {
+        let document_id = document.root_node().id;
+        if !std::ptr::eq(document, plan.document()) {
+            return Err(error(document_id, ClipRouteIssue::InvalidDocument));
+        }
+        if !scale.is_finite() || scale <= 0.0 {
+            return Err(error(document_id, ClipRouteIssue::InvalidScale));
+        }
+        let root = document
+            .try_root_element()
+            .ok_or_else(|| error(document_id, ClipRouteIssue::InvalidDocument))?;
+        let root_style = root
+            .primary_styles()
+            .ok_or_else(|| error(root.id, ClipRouteIssue::MissingStyle))?;
+        let root_overflow_visible = root_style.get_box().overflow_x == Overflow::Visible
+            && root_style.get_box().overflow_y == Overflow::Visible;
+        let initial = PositionedContext {
+            owner: document_id,
+            route: ClipRoute::default(),
+        };
+        let mut inherited = HashMap::from([(
+            document_id,
+            Context {
+                normal: ClipRoute::default(),
+                absolute: initial.clone(),
+                fixed: initial,
+            },
+        )]);
+        let mut routes = Self {
+            nodes: HashMap::with_capacity(plan.entries().len()),
+        };
+        for entry in plan.entries() {
+            let id = entry.node;
+            let node = document
+                .get_node(id)
+                .ok_or_else(|| error(id, ClipRouteIssue::InvalidDocument))?;
+            let context = parent_context(document, plan, &inherited, id)?;
+            let style = node
+                .primary_styles()
+                .ok_or_else(|| error(id, ClipRouteIssue::MissingStyle))?;
+            let transform = *transforms
+                .get(&id)
+                .ok_or_else(|| error(id, ClipRouteIssue::MissingTransform))?;
+            if !transform.as_coeffs().iter().all(|value| value.is_finite()) {
+                return Err(error(id, ClipRouteIssue::NonFiniteGeometry));
+            }
+            let frame = CssBox::from_layout(&style, node.final_layout(), scale);
+            let path = clip_path(id, &style, &frame, scale, transform)?;
+            let css_rect = ClipPathGeometry::new(&style, &frame, scale).css_clip_rect();
+            let css_rect = css_rect
+                .map(|rect| resolved(id, rect.into_path(0.1), transform))
+                .transpose()?;
+            let box_style = style.get_box();
+            let x = box_style.overflow_x;
+            let y = box_style.overflow_y;
+            if matches!(x, Overflow::Clip) || matches!(y, Overflow::Clip) {
+                return Err(error(id, ClipRouteIssue::UnsupportedOverflowClip));
+            }
+            let clip_x = x != Overflow::Visible;
+            let clip_y = y != Overflow::Visible;
+            if clip_x != clip_y {
+                return Err(error(id, ClipRouteIssue::UnsupportedOverflowAxes));
+            }
+            let overflow = if clip_x && id != root.id {
+                // Root overflow is applied by the viewport surface. Body
+                // propagation needs an explicit viewport policy, not its box.
+                if node.local_name() == "body" && root_overflow_visible {
+                    return Err(error(id, ClipRouteIssue::UnsupportedViewportOverflow));
+                }
+                Some(resolved(id, frame.padding_box_path(), transform)?)
+            } else {
+                None
+            };
+            let (context, mut contributions) = route_box(
+                context,
+                id,
+                style.clone_position(),
+                entry.geometry_owner,
+                node.containing_block_claims(),
+                OwnClips {
+                    path,
+                    css_rect,
+                    overflow,
+                },
+            )?;
+            let element = node
+                .element_data()
+                .expect("the plan validated element boxes");
+            let replaced_content = element.raster_image_data().is_some();
+            #[cfg(feature = "custom-widget")]
+            let replaced_content = replaced_content || element.custom_widget_data().is_some();
+            if replaced_content {
+                // Replaced pixels belong to the curved content edge. This clip
+                // must not become a containing-block clip for DOM descendants.
+                let (shape, empty) = resolved(id, frame.content_box_path(), transform)?;
+                contributions.content = contributions.content.append(&shape, empty);
+            }
+            inherited.insert(id, context);
+            routes.nodes.insert(id, contributions);
+        }
+        Ok(routes)
+    }
+
+    pub(super) fn decoration(&self, node: NodeId) -> Option<&ClipRoute> {
+        self.nodes.get(&node).map(|routes| &routes.decoration)
+    }
+
+    pub(super) fn content(&self, node: NodeId) -> Option<&ClipRoute> {
+        self.nodes.get(&node).map(|routes| &routes.content)
+    }
+}
+
+struct OwnClips {
+    path: Option<PreparedClip>,
+    css_rect: Option<PreparedClip>,
+    overflow: Option<PreparedClip>,
+}
+
+fn route_box(
+    mut context: Context,
+    node: NodeId,
+    position: Position,
+    geometry_owner: NodeId,
+    claims: ContainingBlockClaims,
+    own: OwnClips,
+) -> Result<(Context, Contributions)> {
+    context.normal = match position {
+        Position::Absolute => select_positioned(&context.absolute, geometry_owner, node)?,
+        Position::Fixed => select_positioned(&context.fixed, geometry_owner, node)?,
+        _ => context.normal,
+    };
+    if let Some((shape, empty)) = &own.path {
+        context.normal = context.normal.append(shape, *empty);
+        context.absolute.route = context.normal.clone();
+        context.fixed.route = context.normal.clone();
+    }
+    if let Some((shape, empty)) = &own.css_rect {
+        context.normal = context.normal.append(shape, *empty);
+    }
+    let decoration = context.normal.clone();
+    if let Some((shape, empty)) = &own.overflow {
+        context.normal = context.normal.append(shape, *empty);
+    }
+    let content = context.normal.clone();
+    if claims.absolute {
+        context.absolute = PositionedContext {
+            owner: node,
+            route: content.clone(),
+        };
+    } else if let Some((shape, empty)) = &own.css_rect {
+        context.absolute.route = context.absolute.route.append(shape, *empty);
+    }
+    if claims.fixed {
+        context.fixed = PositionedContext {
+            owner: node,
+            route: content.clone(),
+        };
+    } else if let Some((shape, empty)) = &own.css_rect {
+        // Preserve the CSS rect without importing overflow from a containing
+        // block that an escaping fixed descendant does not use.
+        context.fixed.route = context.fixed.route.append(shape, *empty);
+    }
+    Ok((
+        context,
+        Contributions {
+            decoration,
+            content,
+        },
+    ))
+}
+
+fn parent_context(
+    document: &BaseDocument,
+    plan: &PaintOwnershipPlan<'_>,
+    inherited: &HashMap<NodeId, Context>,
+    id: NodeId,
+) -> Result<Context> {
+    let mut cursor = id;
+    let mut visited = HashSet::new();
+    loop {
+        if !visited.insert(cursor) {
+            return Err(error(id, ClipRouteIssue::InvalidFormattingTree));
+        }
+        let parent = document
+            .get_node(cursor)
+            .and_then(|node| node.layout_parent.get())
+            .ok_or_else(|| error(id, ClipRouteIssue::InvalidFormattingTree))?;
+        if let Some(context) = inherited.get(&parent) {
+            return Ok(context.clone());
+        }
+        if plan.entry(parent).is_some() {
+            return Err(error(id, ClipRouteIssue::UnpreparedFormattingParent));
+        }
+        // The plan already rejects positioned/effected non-atomic inline
+        // fragments. Structural boxless parents contribute no box clip.
+        cursor = parent;
+    }
+}
+
+fn select_positioned(
+    context: &PositionedContext,
+    owner: NodeId,
+    node: NodeId,
+) -> Result<ClipRoute> {
+    if context.owner != owner {
+        return Err(error(node, ClipRouteIssue::GeometryOwnerMismatch));
+    }
+    Ok(context.route.clone())
+}
+
+fn clip_path(
+    id: NodeId,
+    style: &ComputedValues,
+    frame: &CssBox,
+    scale: f64,
+    transform: Affine,
+) -> Result<Option<PreparedClip>> {
+    let value = style.clone_clip_path();
+    let path = match &value {
+        ClipPath::None => return Ok(None),
+        ClipPath::Url(_) => return Err(error(id, ClipRouteIssue::UnsupportedClipPathUrl)),
+        ClipPath::Box(reference) => match reference {
+            ShapeGeometryBox::ElementDependent
+            | ShapeGeometryBox::StrokeBox
+            | ShapeGeometryBox::ViewBox
+            | ShapeGeometryBox::ShapeBox(ShapeBox::BorderBox) => frame.border_box_path(),
+            ShapeGeometryBox::ShapeBox(ShapeBox::PaddingBox) => frame.padding_box_path(),
+            ShapeGeometryBox::FillBox | ShapeGeometryBox::ShapeBox(ShapeBox::ContentBox) => {
+                frame.content_box_path()
+            }
+            ShapeGeometryBox::ShapeBox(ShapeBox::MarginBox) => {
+                return Err(error(id, ClipRouteIssue::UnsupportedClipPathBox));
+            }
+        },
+        ClipPath::Shape(shape, reference) => {
+            if matches!(reference, ShapeGeometryBox::ShapeBox(ShapeBox::MarginBox)) {
+                return Err(error(id, ClipRouteIssue::UnsupportedClipPathBox));
+            }
+            match shape.as_ref() {
+                GenericBasicShape::Rect(inset) => {
+                    if !inset.round.is_zero() {
+                        return Err(error(id, ClipRouteIssue::UnsupportedInsetRadius));
+                    }
+                }
+                GenericBasicShape::Polygon(polygon) => {
+                    if polygon.fill != FillRule::Nonzero {
+                        return Err(error(id, ClipRouteIssue::UnsupportedEvenOdd));
+                    }
+                }
+                _ => return Err(error(id, ClipRouteIssue::UnsupportedClipPathShape)),
+            }
+            // For these validated variants, None means a valid empty inset or
+            // polygon. Other legacy None cases were rejected above.
+            let mut path = ClipPathGeometry::new(style, frame, scale)
+                .clip_path_shape()
+                .unwrap_or_default();
+            path.apply_affine(Affine::scale(scale));
+            path
+        }
+    };
+    resolved(id, path, transform).map(Some)
+}
+
+fn resolved(id: NodeId, shape: BezPath, transform: Affine) -> Result<PreparedClip> {
+    if !shape.is_finite() {
+        return Err(error(id, ClipRouteIssue::NonFiniteGeometry));
+    }
+    let bounds = shape.bounding_box();
+    let empty = shape.elements().is_empty() || bounds.width() <= 0.0 || bounds.height() <= 0.0;
+    Ok((Arc::new(ResolvedClip { shape, transform }), empty))
+}
+
+fn error(node: NodeId, issue: ClipRouteIssue) -> ClipRouteError {
+    ClipRouteError { node, issue }
+}
+
+#[cfg(test)]
+mod tests {
