+            id(0),
+            ContainingBlockClaims {
+                absolute: true,
+                fixed: false,
+            },
+            OwnClips {
+                overflow: Some(shape(1.0)),
+                ..own()
+            },
+        )
+        .unwrap();
+        assert!(markers(&contributions.decoration).is_empty());
+        assert_eq!(markers(&contributions.content), [1.0]);
+        let (effect, _) = route_box(
+            ancestor,
