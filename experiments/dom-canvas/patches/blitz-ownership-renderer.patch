+        .unwrap();
+        assert!(markers(&fixed.decoration).is_empty());
+        assert_eq!(markers(&relative.decoration), [1.0]);
+    }
+
+    #[test]
+    fn clip_path_captures_incoming_chain_but_not_its_own_later_overflow() {
+        let (middle, contribution) = route_box(
+            ancestor(),
