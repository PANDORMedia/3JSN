--- /dev/null
+++ b/packages/blitz-paint/src/render/ownership.rs
@@ -0,0 +1,633 @@
+use std::{collections::HashMap, error::Error, fmt};
+
+use anyrender::PaintScene;
+use blitz_dom::{
+    NodeId,
+    paint_ownership::{PaintOwnershipError, PaintOwnershipPlan, PaintPhase},
+};
+use kurbo::{Affine, Point, Rect};
+use peniko::{Fill, Mix};
+use style::{
+    computed_values::visibility::T as Visibility,
+    values::{
+        computed::{BorderStyle, OutlineStyle},
+        generics::image::GenericImage,
+        specified::box_::{DisplayInside, DisplayOutside},
+    },
+};
+
+use super::{
+    BlitzDomPainter,
+    ownership_clips::{ClipRouteError, ClipRoutes},
+};
+use crate::{
+    PaintError,
+    color::{Color, ToColorColor},
+};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum OwnershipPaintIssue {
+    PendingResources,
+    InvalidViewport,
+    MissingPreparedNode,
+    UnsupportedFormatting,
+    UnsupportedContent,
+    UnsupportedInline,
+    UnsupportedFormControl,
+    UnsupportedSubdocument,
+    UnsupportedEffect,
+    UnsupportedDecoration,
+    UnsupportedRootEffect,
+    UnsupportedCanvasBackground,
+    UnsupportedWidgetTransform,
+    UnsupportedOverlay,
+    InvalidGeometry,
+}
+
+#[derive(Debug)]
+pub enum OwnershipPaintError {
+    Plan(PaintOwnershipError),
+    Clip(ClipRouteError),
+    Unsupported {
+        node: NodeId,
+        issue: OwnershipPaintIssue,
+    },
+    Budget(PaintError),
+}
+
+impl fmt::Display for OwnershipPaintError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Plan(error) => write!(f, "{error}"),
+            Self::Clip(error) => write!(f, "{error}"),
+            Self::Budget(error) => write!(f, "{error}"),
+            Self::Unsupported { node, issue } => {
+                write!(f, "ownership painting {issue:?} at {node:?}")
+            }
+        }
+    }
+}
+
+impl Error for OwnershipPaintError {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::Plan(error) => Some(error),
+            Self::Clip(error) => Some(error),
+            Self::Budget(error) => Some(error),
+            Self::Unsupported { .. } => None,
+        }
+    }
+}
+
+impl From<PaintError> for OwnershipPaintError {
+    fn from(error: PaintError) -> Self {
+        Self::Budget(error)
+    }
+}
+impl From<PaintOwnershipError> for OwnershipPaintError {
+    fn from(error: PaintOwnershipError) -> Self {
+        Self::Plan(error)
+    }
+}
+impl From<ClipRouteError> for OwnershipPaintError {
+    fn from(error: ClipRouteError) -> Self {
+        Self::Clip(error)
+    }
+}
+
+type Result<T> = std::result::Result<T, OwnershipPaintError>;
+
+fn unsupported(node: NodeId, issue: OwnershipPaintIssue) -> OwnershipPaintError {
+    OwnershipPaintError::Unsupported { node, issue }
+}
+
+#[derive(Clone, Copy)]
+enum InFlowKind {
+    Block,
+    Atomic,
+}
+
+/// Frame-local ownership, transforms and routes are all derived from one resolved
+/// document. No legacy paint-child or geometry-overflow list participates.
+struct PreparedFrame<'document> {
+    plan: PaintOwnershipPlan<'document>,
+    transforms: HashMap<NodeId, Affine>,
+    flow_kind: HashMap<NodeId, InFlowKind>,
+    clips: ClipRoutes,
+    root: NodeId,
+    viewport: Rect,
+    canvas_background: (NodeId, Color),
+}
+
+impl<'document> PreparedFrame<'document> {
+    fn build(painter: &BlitzDomPainter<'document, '_>) -> Result<Self> {
+        let doc = painter.dom;
+        let document_node = doc.root_node().id;
+        if doc.has_pending_critical_resources() {
+            return Err(unsupported(
+                document_node,
+                OwnershipPaintIssue::PendingResources,
+            ));
+        }
+        if !painter.scale.is_finite()
+            || painter.scale <= 0.0
+            || !painter.initial_x.is_finite()
+            || !painter.initial_y.is_finite()
+            || painter.width == 0
+            || painter.height == 0
+        {
+            return Err(unsupported(
+                document_node,
+                OwnershipPaintIssue::InvalidViewport,
+            ));
+        }
+        let devtools = doc.devtools();
+        if devtools.show_layout || devtools.highlight_hover || devtools.highlight_node.is_some() {
+            return Err(unsupported(
+                document_node,
+                OwnershipPaintIssue::UnsupportedOverlay,
+            ));
+        }
+        let plan = PaintOwnershipPlan::build(doc)?;
+        let root = plan
+            .entries()
+            .iter()
+            .find(|entry| entry.phase == PaintPhase::Root)
+            .map(|entry| entry.node)
+            .ok_or_else(|| unsupported(document_node, OwnershipPaintIssue::MissingPreparedNode))?;
+        let canvas_background = canvas_background(painter, root)?;
+        let mut transforms: HashMap<NodeId, Affine> = HashMap::new();
+        let mut flow_kind = HashMap::new();
+        for entry in plan.entries() {
+            let node = doc
+                .get_node(entry.node)
+                .ok_or_else(|| unsupported(entry.node, OwnershipPaintIssue::MissingPreparedNode))?;
+            let element = node.element_data().ok_or_else(|| {
+                unsupported(entry.node, OwnershipPaintIssue::UnsupportedFormatting)
+            })?;
+            if element.name.ns.as_ref() != "http://www.w3.org/1999/xhtml"
+                || matches!(
+                    element.name.local.as_ref(),
+                    "video" | "embed" | "object" | "iframe"
+                )
+            {
+                return Err(unsupported(
+                    entry.node,
+                    OwnershipPaintIssue::UnsupportedContent,
+                ));
+            }
+            let styles = node.primary_styles().ok_or_else(|| {
+                unsupported(entry.node, OwnershipPaintIssue::UnsupportedFormatting)
+            })?;
+            let display = styles.clone_display();
+            if !matches!(
+                display.inside(),
+                DisplayInside::Flow
+                    | DisplayInside::FlowRoot
+                    | DisplayInside::Flex
+                    | DisplayInside::Grid
+            ) || element.list_item_data.is_some()
+            {
+                return Err(unsupported(
+                    entry.node,
+                    OwnershipPaintIssue::UnsupportedFormatting,
+                ));
+            }
+            if node.flags.is_inline_root() {
+                return Err(unsupported(
+                    entry.node,
+                    OwnershipPaintIssue::UnsupportedInline,
+                ));
+            }
+            if matches!(
+                element.name.local.as_ref(),
+                "input" | "textarea" | "button" | "select" | "option"
+            ) || element.text_input_data().is_some()
+            {
+                return Err(unsupported(
+                    entry.node,
+                    OwnershipPaintIssue::UnsupportedFormControl,
+                ));
+            }
+            if element.sub_doc_data().is_some() {
+                return Err(unsupported(
+                    entry.node,
+                    OwnershipPaintIssue::UnsupportedSubdocument,
+                ));
+            }
+            let effects = styles.get_effects();
+            if !effects.filter.0.is_empty()
+                || !effects.backdrop_filter.0.is_empty()
+                || styles
+                    .get_svg()
+                    .mask_image
+                    .0
+                    .iter()
+                    .any(|image| !matches!(image, GenericImage::None))
+            {
+                return Err(unsupported(
+                    entry.node,
+                    OwnershipPaintIssue::UnsupportedEffect,
+                ));
+            }
+            if !effects.box_shadow.0.is_empty()
+                || !matches!(
+                    styles.get_outline().outline_style,
+                    OutlineStyle::BorderStyle(BorderStyle::None | BorderStyle::Hidden)
+                )
+            {
+                return Err(unsupported(
+                    entry.node,
+                    OwnershipPaintIssue::UnsupportedDecoration,
+                ));
+            }
+            if entry.node == root
+                && (effects.opacity != 1.0
+                    || styles.get_inherited_box().visibility != Visibility::Visible)
+            {
+                return Err(unsupported(
+                    entry.node,
+                    OwnershipPaintIssue::UnsupportedRootEffect,
+                ));
+            }
+            #[cfg(feature = "scrollbars")]
+            if node.wants_scrollbar(taffy::AbsoluteAxis::Horizontal)
+                || node.wants_scrollbar(taffy::AbsoluteAxis::Vertical)
+            {
+                return Err(unsupported(
+                    entry.node,
+                    OwnershipPaintIssue::UnsupportedOverlay,
+                ));
+            }
+            let layout = node.final_layout();
+            if ![
+                layout.location.x,
+                layout.location.y,
+                layout.size.width,
+                layout.size.height,
+                layout.padding.left,
+                layout.padding.right,
+                layout.padding.top,
+                layout.padding.bottom,
+                layout.border.left,
+                layout.border.right,
+                layout.border.top,
+                layout.border.bottom,
+                effects.opacity,
+            ]
+            .iter()
+            .all(|value| value.is_finite())
+            {
+                return Err(unsupported(
+                    entry.node,
+                    OwnershipPaintIssue::InvalidGeometry,
+                ));
+            }
+            let owner_transform = match entry.paint_owner {
+                Some(owner) => *transforms.get(&owner).ok_or_else(|| {
+                    unsupported(entry.node, OwnershipPaintIssue::MissingPreparedNode)
+                })?,
+                None => Affine::translate((painter.initial_x, painter.initial_y)),
+            };
+            let transform = owner_transform
+                * Affine::translate((
+                    f64::from(entry.prefix.x) * painter.scale,
+                    f64::from(entry.prefix.y) * painter.scale,
+                ))
+                * Affine::translate((
+                    f64::from(layout.location.x) * painter.scale,
+                    f64::from(layout.location.y) * painter.scale,
+                ))
+                * node
+                    .transform()
+                    .as_deref()
+                    .copied()
+                    .unwrap_or(Affine::IDENTITY);
+            if !transform.as_coeffs().iter().all(|value| value.is_finite())
+                || transform.determinant() == 0.0
+            {
+                return Err(unsupported(
+                    entry.node,
+                    OwnershipPaintIssue::InvalidGeometry,
+                ));
+            }
+            #[cfg(feature = "custom-widget")]
+            if element.custom_widget_data().is_some() {
+                let [a, b, c, d, _, _] = transform.as_coeffs();
+                let has_local_offset = layout.border.left + layout.padding.left != 0.0
+                    || layout.border.top + layout.padding.top != 0.0;
+                if has_local_offset && [a, b, c, d] != [1.0, 0.0, 0.0, 1.0] {
+                    return Err(unsupported(
+                        entry.node,
+                        OwnershipPaintIssue::UnsupportedWidgetTransform,
+                    ));
+                }
+            }
+            transforms.insert(entry.node, transform);
+            let flex_or_grid_item = node
+                .layout_parent
+                .get()
+                .and_then(|parent| doc.get_node(parent))
+                .and_then(|parent| parent.primary_styles().map(|style| style.clone_display()))
+                .is_some_and(|display| {
+                    matches!(display.inside(), DisplayInside::Flex | DisplayInside::Grid)
+                });
+            let atomic = flex_or_grid_item || display.outside() == DisplayOutside::Inline;
+            flow_kind.insert(
+                entry.node,
+                if atomic {
+                    InFlowKind::Atomic
+                } else {
+                    InFlowKind::Block
+                },
+            );
+        }
+        let clips = ClipRoutes::build(doc, &plan, &transforms, painter.scale)?;
+        for entry in plan.entries() {
+            if clips.decoration(entry.node).is_none() || clips.content(entry.node).is_none() {
+                return Err(unsupported(
+                    entry.node,
+                    OwnershipPaintIssue::MissingPreparedNode,
+                ));
+            }
+        }
+        Ok(Self {
+            plan,
+            transforms,
+            flow_kind,
+            clips,
+            root,
+            canvas_background,
+            viewport: Rect::from_origin_size(
+                (painter.initial_x, painter.initial_y),
+                (f64::from(painter.width), f64::from(painter.height)),
+            ),
+        })
+    }
+}
+
+fn canvas_background(painter: &BlitzDomPainter<'_, '_>, root: NodeId) -> Result<(NodeId, Color)> {
+    let node = painter
+        .dom
+        .get_node(root)
+        .ok_or_else(|| unsupported(root, OwnershipPaintIssue::MissingPreparedNode))?;
+    let root_style = node
+        .primary_styles()
+        .ok_or_else(|| unsupported(root, OwnershipPaintIssue::MissingPreparedNode))?;
+    let root_color = root_style
+        .clone_background_color()
+        .resolve_to_absolute(&root_style.clone_color())
+        .as_srgb_color();
+    if root_style
+        .get_background()
+        .background_image
+        .0
+        .iter()
+        .any(|image| !matches!(image, GenericImage::None))
+    {
+        return Err(unsupported(
+            root,
+            OwnershipPaintIssue::UnsupportedCanvasBackground,
+        ));
+    }
+    if root_color.components[3] != 0.0 {
+        return Ok((root, root_color));
+    }
+    let body = node
+        .children
+        .iter()
+        .filter_map(|id| painter.dom.get_node(*id))
+        .find(|node| {
+            node.data
+                .is_element_with_tag_name(&blitz_dom::local_name!("body"))
+        });
+    let Some(body) = body else {
+        return Ok((root, root_color));
+    };
+    let body_style = body
+        .primary_styles()
+        .ok_or_else(|| unsupported(body.id, OwnershipPaintIssue::UnsupportedCanvasBackground))?;
+    if !body.has_boxes() {
+        if body_style.clone_display().is_none() {
+            return Ok((root, root_color));
+        }
+        return Err(unsupported(
+            body.id,
+            OwnershipPaintIssue::UnsupportedCanvasBackground,
+        ));
+    }
+    if body_style
+        .get_background()
+        .background_image
+        .0
+        .iter()
+        .any(|image| !matches!(image, GenericImage::None))
+    {
+        return Err(unsupported(
+            body.id,
+            OwnershipPaintIssue::UnsupportedCanvasBackground,
+        ));
+    }
+    Ok((
+        body.id,
+        body_style
+            .clone_background_color()
+            .resolve_to_absolute(&body_style.clone_color())
+            .as_srgb_color(),
+    ))
+}
+
+impl BlitzDomPainter<'_, '_> {
+    pub(crate) fn paint_scene_with_ownership(&self, scene: &mut impl PaintScene) -> Result<()> {
+        let prepared = PreparedFrame::build(self)?;
+        let _location = self.paint_context.enter(self.dom.id(), Some(prepared.root));
+        // The propagated canvas background has no element box. Root clips apply
+        // to the root's border/content and descendants, not this viewport fill.
+        scene.fill(
+            Fill::NonZero,
+            Affine::IDENTITY,
+            prepared.canvas_background.1,
+            None,
+            &prepared.viewport,
+        );
+        self.paint_owned_group(scene, &prepared, prepared.root)
+    }
+
+    fn paint_owned_group(
+        &self,
+        scene: &mut impl PaintScene,
+        prepared: &PreparedFrame<'_>,
+        id: NodeId,
+    ) -> Result<()> {
+        let node = self
+            .dom
+            .get_node(id)
+            .ok_or_else(|| unsupported(id, OwnershipPaintIssue::MissingPreparedNode))?;
+        let styles = node
+            .primary_styles()
+            .ok_or_else(|| unsupported(id, OwnershipPaintIssue::MissingPreparedNode))?;
+        let opacity = styles.get_effects().opacity;
+        if opacity == 0.0 {
+            return Ok(());
+        }
+        let _location = self.paint_context.enter(self.dom.id(), Some(id));
+        let grouped = opacity < 1.0;
+        if grouped {
+            // Geometry-overflow bounds omit escaping descendants. The viewport is
+            // conservative for every contribution that can reach this surface.
+            scene.push_layer(
+                Mix::Normal,
+                opacity,
+                Affine::IDENTITY,
+                &prepared.viewport,
+                None,
+                None,
+            );
+        }
+        let result = self.paint_owned_group_contents(scene, prepared, id);
+        if grouped {
+            scene.pop_layer();
+        }
+        result
+    }
+
+    fn paint_owned_group_contents(
+        &self,
+        scene: &mut impl PaintScene,
+        prepared: &PreparedFrame<'_>,
+        id: NodeId,
+    ) -> Result<()> {
+        self.paint_owned_contribution(scene, prepared, id, true)?;
+        for child in prepared
+            .plan
+            .children(id)
+            .filter(|entry| matches!(entry.phase, PaintPhase::Negative(_)))
+        {
+            self.paint_owned_group(scene, prepared, child.node)?;
+        }
+        self.paint_inflow_decorations(scene, prepared, id)?;
+        self.paint_owned_contribution(scene, prepared, id, false)?;
+        self.paint_inflow_contents(scene, prepared, id)?;
+        for child in prepared
+            .plan
+            .children(id)
+            .filter(|entry| matches!(entry.phase, PaintPhase::Zero | PaintPhase::Positive(_)))
+        {
+            self.paint_owned_group(scene, prepared, child.node)?;
+        }
+        Ok(())
+    }
+
+    fn paint_inflow_decorations(
+        &self,
+        scene: &mut impl PaintScene,
+        prepared: &PreparedFrame<'_>,
+        owner: NodeId,
+    ) -> Result<()> {
+        for child in prepared
+            .plan
+            .children(owner)
+            .filter(|entry| entry.phase == PaintPhase::InFlow)
+        {
+            if matches!(prepared.flow_kind.get(&child.node), Some(InFlowKind::Block)) {
+                self.paint_owned_contribution(scene, prepared, child.node, true)?;
+                self.paint_inflow_decorations(scene, prepared, child.node)?;
+            }
+        }
+        Ok(())
+    }
+
+    fn paint_inflow_contents(
+        &self,
+        scene: &mut impl PaintScene,
+        prepared: &PreparedFrame<'_>,
+        owner: NodeId,
+    ) -> Result<()> {
+        for child in prepared
+            .plan
+            .children(owner)
+            .filter(|entry| entry.phase == PaintPhase::InFlow)
+        {
+            match prepared.flow_kind.get(&child.node) {
+                Some(InFlowKind::Block) => {
+                    self.paint_owned_contribution(scene, prepared, child.node, false)?;
+                    self.paint_inflow_contents(scene, prepared, child.node)?;
+                }
+                Some(InFlowKind::Atomic) => self.paint_owned_group(scene, prepared, child.node)?,
+                None => {
+                    return Err(unsupported(
+                        child.node,
+                        OwnershipPaintIssue::MissingPreparedNode,
+                    ));
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn paint_owned_contribution(
+        &self,
+        scene: &mut impl PaintScene,
+        prepared: &PreparedFrame<'_>,
+        id: NodeId,
+        decoration: bool,
+    ) -> Result<()> {
+        let node = self
+            .dom
+            .get_node(id)
+            .ok_or_else(|| unsupported(id, OwnershipPaintIssue::MissingPreparedNode))?;
+        let styles = node
+            .primary_styles()
+            .ok_or_else(|| unsupported(id, OwnershipPaintIssue::MissingPreparedNode))?;
+        // Visibility suppresses this contribution, not independently visible descendants.
+        if styles.get_inherited_box().visibility != Visibility::Visible {
+            return Ok(());
+        }
+        let custom_widget = self.custom_widget_scenes.get(&(self.dom.id(), id));
+        if !decoration
+            && node
+                .element_data()
+                .and_then(|element| element.raster_image_data())
+                .is_none()
+            && custom_widget.is_none_or(|scene| scene.commands.is_empty())
+        {
+            return Ok(());
+        }
+        let route = if decoration {
+            prepared.clips.decoration(id)
+        } else {
+            prepared.clips.content(id)
+        }
+        .ok_or_else(|| unsupported(id, OwnershipPaintIssue::MissingPreparedNode))?;
+        if route.is_empty() {
+            return Ok(());
+        }
+        let transform = *prepared
+            .transforms
+            .get(&id)
+            .ok_or_else(|| unsupported(id, OwnershipPaintIssue::MissingPreparedNode))?;
+        let cx = self.element_cx(node, *node.final_layout(), transform, custom_widget);
+        let _location = self.paint_context.enter(self.dom.id(), Some(id));
+        let mut layers = 0usize;
+        for clip in route.clips() {
+            scene.push_clip_layer(clip.transform, &clip.shape);
+            layers += 1;
+        }
+        if decoration {
+            cx.draw_own_decoration(scene, id != prepared.canvas_background.0);
+        } else {
+            let layout = node.final_layout();
+            cx.draw_own_content(
+                scene,
+                Point::new(
+                    f64::from(layout.border.left + layout.padding.left),
+                    f64::from(layout.border.top + layout.padding.top),
+                ),
+            );
+        }
+        for _ in 0..layers {
+            scene.pop_layer();
+        }
+        Ok(())
+    }
+}
