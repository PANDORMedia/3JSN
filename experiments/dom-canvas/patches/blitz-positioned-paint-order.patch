+        let mut ordering_roots = modified_stacking_roots.clone();
+        // Unmodified contexts are already z-sorted by the style flush. Include
+        // their nonzero ties too: flex/grid order can change without OOF boxes.
+        ordering_roots.extend(self.nodes.iter().filter_map(|(id, node)| {
+            let sc = node.stacking_context.as_ref()?;
+            sc.children
+                .windows(2)
+                .any(|pair| pair[0].z_index != 0 && pair[0].z_index == pair[1].z_index)
+                .then_some(id)
+        }));
+        ordering_roots.sort_unstable();
+        ordering_roots.dedup();
+        if ordering_roots.is_empty() {
+            return;
+        }
+        let paint_order = crate::layout::paint_order::PaintOrder::new(self);
+        for sc_root in ordering_roots {
             let mut sc = self.nodes[sc_root].stacking_context.take();
