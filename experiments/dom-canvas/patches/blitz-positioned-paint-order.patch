                 sc.sort();
-                sc.compute_content_size(self);
+                // Detached retained nodes may still have old stacking lists.
+                if paint_order.contains_node(sc_root) {
+                    paint_order.sort_nonzero_ties(sc);
+                }
+                if modified_stacking_roots.binary_search(&sc_root).is_ok() {
+                    sc.compute_content_size(self);
+                }
             }
             self.nodes[sc_root].stacking_context = sc;
         }
