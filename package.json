{
  "name": "3jsn",
  "version": "0.0.0",
  "private": true,
  "description": "Research and foundations for a Three.js native game engine.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "3jsn": "packages/cli/cli.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test scripts/compatibility/*.test.mjs packages/cli/*.test.mjs experiments/compiled-ui/compiler.test.mjs",
    "probe:gpu": "node --expose-gc experiments/native-webgpu/probe.mjs",
    "probe:runtime": "node scripts/probe-runtime.mjs",
    "probe:three": "node scripts/probe-three.mjs",
    "probe:window-lifecycle": "node scripts/probe-window-lifecycle.mjs",
    "probe:package": "node scripts/probe-package.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "pngjs": "7.0.0",
    "three": "0.186.0",
    "webgpu": "0.6.1"
  },
  "devDependencies": {
    "css-tree": "3.2.1",
    "esbuild": "0.28.2",
    "parse5": "8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.21.3"
  }
}
